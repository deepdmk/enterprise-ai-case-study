# Phase 3 MoE Experts Configuration
# Copy this file to .env and fill in your values

# Hugging Face
HF_TOKEN=your_huggingface_token_here
HF_HOME=/path/to/hf/cache

# Phase 2 Import
PHASE2_EXPORT_DIR=../phase-2-task-slms/exports

# Merge Settings
MERGE_USE_CUDA=true
MERGE_TRUST_REMOTE_CODE=false
MERGE_TIMEOUT_MINUTES=60

# Export Settings
EXPORT_GENERATE_AGENT_CONFIGS=true
EXPORT_GENERATE_ROUTING_EMBEDDINGS=true
EXPORT_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Paths
DATA_DIR=./data
IMPORTS_DIR=./data/imports
CONFIGS_DIR=./data/configs
MERGED_DIR=./data/merged
EXPORTS_DIR=./data/exports

# Logging
LOG_LEVEL=INFO

# Test Mode
TEST_MODE=false
