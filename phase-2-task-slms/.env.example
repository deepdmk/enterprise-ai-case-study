# Phase 2 Task SLMs Configuration
# Copy this file to .env and fill in your values

# Hugging Face
HF_TOKEN=your_huggingface_token_here
HF_HOME=/path/to/hf/cache

# Model Settings
BASE_MODEL=unsloth/Meta-Llama-3.1-8B-bnb-4bit
MAX_SEQ_LENGTH=2048

# Training Settings
TRAIN_EPOCHS=3
TRAIN_BATCH_SIZE=4
GRADIENT_ACCUMULATION_STEPS=4
LEARNING_RATE=3e-4

# Paths
DATA_DIR=./data
MODELS_DIR=./data/models
REGISTRY_DIR=./data/registry

# Phase 1 Integration (optional)
PHASE1_CONFIG_PATH=../phase-1-embed-space/config/config.yaml

# Logging
LOG_LEVEL=INFO

# Test Mode
TEST_MODE=false
TEST_SAMPLES=50
TEST_EPOCHS=1
