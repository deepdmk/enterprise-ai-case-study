# Phase 4: Agentic Discovery - Environment Variables

# General Settings
PHASE4_TEST_MODE=false
PHASE4_DEVICE=cuda  # cuda, cpu, or mps

# Paths to other phases (optional - will auto-detect if not set)
PHASE4_PATHS__PHASE3_PATH=../phase-3-moe-experts
PHASE4_PATHS__PHASE1_PATH=../phase-1-embed-space
PHASE4_PATHS__PHASE0_PATH=../phase-0-infrastructure

# A2A Protocol Settings
PHASE4_A2A_PROTOCOL__DEFAULT_MAX_DEPTH=3
PHASE4_A2A_PROTOCOL__DEFAULT_TIMEOUT_MS=5000
PHASE4_A2A_PROTOCOL__MAX_CASCADE_DEPTH=4

# Program 1: A2A Fine-Tuning
PHASE4_A2A_FINETUNING__NUM_TRAINING_EXAMPLES=1000
PHASE4_A2A_FINETUNING__LORA_RANK=16
PHASE4_A2A_FINETUNING__LORA_ALPHA=32
PHASE4_A2A_FINETUNING__LEARNING_RATE=0.0002
PHASE4_A2A_FINETUNING__NUM_EPOCHS=3
PHASE4_A2A_FINETUNING__BATCH_SIZE=4

# Program 2: Agent Services
PHASE4_AGENT_SERVICES__BASE_PORT=8000
PHASE4_AGENT_SERVICES__HOST=0.0.0.0

# Program 3: Discovery Pipeline
PHASE4_DISCOVERY_PIPELINE__QUERIES_PER_DAY=10

# Program 4: Adaptive Analyzer
PHASE4_ADAPTIVE_ANALYZER__MIN_SUCCESS_RATE=0.8

# Logging
LOG_LEVEL=INFO
