# Phase 5: Orchestrated Agentic - Environment Variables
# Copy this file to .env and fill in your values

# General Settings
PHASE5_TEST_MODE=false
PHASE5_DEVICE=cuda  # cuda, cpu, or mps

# Phase 4 Data Import
PHASE4_EXPORTS_DIR=../phase-4-agentic-discovery/data/exports

# Paths to other phases (optional - will auto-detect if not set)
PHASE5_PATHS__PHASE4_PATH=../phase-4-agentic-discovery
PHASE5_PATHS__PHASE0_PATH=../phase-0-infrastructure

# Fine-tuning Settings
PHASE5_FINETUNING__BASE_MODEL=Qwen/Qwen2.5-7B
PHASE5_FINETUNING__LORA_RANK=16
PHASE5_FINETUNING__LORA_ALPHA=32
PHASE5_FINETUNING__LEARNING_RATE=0.0002
PHASE5_FINETUNING__NUM_EPOCHS=3
PHASE5_FINETUNING__BATCH_SIZE=4

# Inference Server
PHASE5_INFERENCE__SERVER=vllm  # vllm or transformers
PHASE5_INFERENCE__HOST=0.0.0.0
PHASE5_INFERENCE__PORT=8100

# Orchestrator Service
PHASE5_ORCHESTRATOR__HOST=0.0.0.0
PHASE5_ORCHESTRATOR__PORT=8200

# Agent Endpoints
PHASE5_AGENT_URLS__FUNDRAISING=http://localhost:8001
PHASE5_AGENT_URLS__BUSINESS_DEVELOPMENT=http://localhost:8002
PHASE5_AGENT_URLS__FIELD_OPERATIONS=http://localhost:8003

# Logging
LOG_LEVEL=INFO
